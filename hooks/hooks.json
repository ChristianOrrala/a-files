{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/a-files/scripts/afiles_hook.py\" session-start --emit auto",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/a-files/scripts/afiles_hook.py\" before-stop --emit auto",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
